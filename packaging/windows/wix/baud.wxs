<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- UpgradeCode fijo: no cambiar entre versiones, es la identidad de producto para MajorUpgrade. -->
  <Package Name="Baud"
           Manufacturer="Baud"
           Version="$(var.BaudVersion)"
           UpgradeCode="BA1B21AF-39C6-4282-9308-56286E29B1B3"
           Language="1033"
           Scope="perMachine">

    <SummaryInformation Description="Baud terminal emulator installer" Manufacturer="Baud" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Baud is already installed." />

    <Icon Id="BaudIcon" SourceFile="$(var.BaudIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="BaudIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/KarloZ7715/Baud" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Baud">
        <Component Id="BaudExecutable" Guid="C61C7365-2C93-4CA8-BB01-E534D2032984">
          <File Id="BaudExe" Source="$(var.BaudExePath)" KeyPath="yes" />
        </Component>
        <Component Id="BaudLicense" Guid="1756C607-64CC-49CB-9179-ED8382435B70">
          <File Id="LicenseFile" Source="$(var.BaudLicensePath)" Name="LICENSE" KeyPath="yes" />
        </Component>
        <Component Id="BaudThirdPartyLicenses" Guid="E1500CB9-B6B5-4473-91D4-CE88F3DC1273">
          <File Id="ThirdPartyLicenseFile" Source="$(var.BaudThirdPartyLicensePath)" Name="LICENSES-THIRD-PARTY" KeyPath="yes" />
        </Component>
        <Component Id="ConptyDll" Guid="B90B7CC7-BD76-49F1-BAAC-E41B61D66E5E">
          <File Id="ConptyDll" Source="$(var.BaudConptyDllPath)" Name="conpty.dll" KeyPath="yes" />
        </Component>
        <Component Id="OpenConsoleExe" Guid="89FC7A88-5997-448D-813A-38FA5788704C">
          <File Id="OpenConsoleExe" Source="$(var.BaudOpenConsolePath)" Name="OpenConsole.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="BaudStartMenuFolder" Name="Baud">
        <Component Id="BaudShortcut" Guid="CA7D8925-D7B8-45AA-8921-BB9D2226E7BA">
          <Shortcut Id="BaudStartMenuShortcut"
                    Name="Baud"
                    Description="Baud terminal emulator"
                    Target="[INSTALLFOLDER]baud.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="BaudIcon" />
          <RemoveFolder Id="RemoveBaudStartMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Baud" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="StartupFolder">
      <Component Id="BaudDaemonStartup" Guid="CF8FBB77-9697-48B4-B539-E9268DC18F92">
        <Shortcut Id="BaudDaemonStartupShortcut"
                  Name="Baud daemon"
                  Description="Baud session daemon"
                  Target="[INSTALLFOLDER]baud.exe"
                  Arguments="--server"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="BaudIcon" />
        <RegistryValue Root="HKCU" Key="Software\Baud" Name="daemonStartup" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Baud" Level="1">
      <ComponentRef Id="BaudExecutable" />
      <ComponentRef Id="BaudLicense" />
      <ComponentRef Id="BaudThirdPartyLicenses" />
      <ComponentRef Id="ConptyDll" />
      <ComponentRef Id="OpenConsoleExe" />
      <ComponentRef Id="BaudShortcut" />
      <ComponentRef Id="BaudDaemonStartup" />
    </Feature>

    <!-- Sin esto, WiX genera un cabinet externo (cab1.cab) que el instalador
         busca junto al .msi; al descargar solo el .msi desde el release, falla. -->
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.BaudLicenseRtfPath)" />

  </Package>
</Wix>
